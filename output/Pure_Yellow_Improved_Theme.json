{
  "name": "Pure Yellow Improved",
  "dataColors": [
    "#858500",
    "#253659",
    "#545400",
    "#16A34A",
    "#DC2626",
    "#CCCC00",
    "#D97706",
    "#0284C7",
    "#7C3AED",
    "#FFFF00",
    "#FFFF66",
    "#FFFFB3"
  ],
  "background": "#FFFFF5",
  "foreground": "#25251F",
  "tableAccent": "#858500",
  "good": "#16A34A",
  "neutral": "#CCCC00",
  "bad": "#DC2626",
  "maximum": "#16A34A",
  "center": "#FFFF00",
  "minimum": "#DC2626",
  "null": "#E5E5D8",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Bold",
      "color": "#25251F"
    },
    "title": {
      "fontSize": 16,
      "fontFace": "Segoe UI Bold",
      "color": "#545400"
    },
    "header": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#545400"
    },
    "label": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#25251F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CCCC00" } },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#545400" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 16,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFF5" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#FFFFE8" } },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#858500" } },
            "radius": 10
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#545400" } },
            "background": { "solid": { "color": "#FFFFF5" } },
            "outline": "BottomOnly",
            "textSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#25251F" } },
            "background": { "solid": { "color": "#FFFFE8" } },
            "outline": "Frame",
            "textSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#25251F" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#545400" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CCCC00" } },
            "radius": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#CCCC00" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#858500" } },
            "outlineWeight": 2,
            "textSize": 12
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#25251F" } },
            "backColor": { "solid": { "color": "#FFFF00" } },
            "outline": "BottomOnly",
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#25251F" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#25251F" } },
            "backColorSecondary": { "solid": { "color": "#FFFFF5" } },
            "outline": "Frame",
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "totals": true,
            "fontColor": { "solid": { "color": "#545400" } },
            "backColor": { "solid": { "color": "#FFFFE8" } },
            "outline": "TopOnly",
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#CCCC00" } },
            "gridHorizontalWeight": 1,
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#858500" } },
            "outlineWeight": 2,
            "textSize": 12
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#25251F" } },
            "backColor": { "solid": { "color": "#FFFF00" } },
            "outline": "BottomOnly",
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#25251F" } },
            "backColor": { "solid": { "color": "#FFFFF5" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#25251F" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#25251F" } },
            "backColorSecondary": { "solid": { "color": "#FFFFF5" } },
            "outline": "Frame",
            "fontSize": 12,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#545400" } },
            "backColor": { "solid": { "color": "#FFFFE8" } },
            "outline": "TopOnly",
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": { "solid": { "color": "#FFFFF5" } },
            "transparency": 0
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": { "solid": { "color": "#FFFFB3" } },
            "transparency": 0
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": { "solid": { "color": "#545400" } },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": { "solid": { "color": "#545400" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "bold": true
          },
          {
            "$id": "hover",
            "show": true,
            "fontColor": { "solid": { "color": "#25251F" } },
            "bold": true
          },
          {
            "$id": "selected",
            "show": true,
            "fontColor": { "solid": { "color": "#FFFF00" } },
            "bold": true
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": { "solid": { "color": "#858500" } },
            "weight": 1
          },
          {
            "$id": "selected",
            "show": true,
            "lineColor": { "solid": { "color": "#545400" } },
            "weight": 2
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "rectangleRoundedCurve": 10
          }
        ]
      }
    },
    "shape": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": { "solid": { "color": "#FFFFF5" } },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": { "solid": { "color": "#858500" } },
            "weight": 2
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": { "solid": { "color": "#16A34A" } },
            "decreaseFill": { "solid": { "color": "#DC2626" } },
            "totalFill": { "solid": { "color": "#253659" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "fontSize": 11,
            "gridlineColor": { "solid": { "color": "#E5E500" } }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#25251F" } },
            "fontSize": 11
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "dataPoint": [
          {
            "fill": { "solid": { "color": "#858500" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "titleColor": { "solid": { "color": "#545400" } },
            "fontSize": 11,
            "gridlineColor": { "solid": { "color": "#E5E500" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "titleColor": { "solid": { "color": "#545400" } },
            "fontSize": 11,
            "gridlineColor": { "solid": { "color": "#E5E500" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#25251F" } },
            "fontSize": 11
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": { "solid": { "color": "#858500" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "fontSize": 11
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#25251F" } },
            "secLabelColor": { "solid": { "color": "#253659" } },
            "gridlineColor": { "solid": { "color": "#E5E500" } },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#25251F" } },
            "fontSize": 11
          }
        ]
      }
    }
  }
}
